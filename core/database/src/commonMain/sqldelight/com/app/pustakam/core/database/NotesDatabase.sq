-- 🔧 30-Jul-2026 02:10 was ...core.database.localdb.data (no such package); RichTextMetadata now lives in :core:model
import com.app.pustakam.core.model.models.RichTextMetadata;

-- 🔧 21-Jul-2026 databasev2.md §2.4: offline-first sync fields — ownerId/version are app-generated
--   uuid strings (never hardcoded), syncStatus drives the sync queue, deleted = soft delete tombstone.
--   Existing installs get these via migration 3.sqm (v3 -> v4).
CREATE TABLE Notes (
 id TEXT NOT NULL PRIMARY KEY,
 categoryId TEXT,
 title TEXT,
 createdAt TEXT,
 updatedAt TEXT,
 ownerId TEXT,
 version TEXT NOT NULL DEFAULT '',
 syncStatus TEXT NOT NULL DEFAULT 'PENDING',
 deleted INTEGER NOT NULL DEFAULT 0,
 -- 🔄 20-Aug-2026 sync: a delete becomes a tombstone. A DELETE row can never reach another device.
 deletedAt TEXT,
 -- 🔄 the SERVER's clock, never the phone's — this is what pull pages on
 serverUpdatedAt INTEGER
);

CREATE TABLE NoteContent(
id TEXT NOT NULL PRIMARY KEY,
noteId TEXT NOT NULL REFERENCES Notes(id) ON DELETE CASCADE ,
type TEXT NOT NULL,
position REAL,
createdAt TEXT,
updatedAt TEXT,
localPath TEXT,
url TEXT,
text TEXT,
lat  REAL,
long REAL,
address TEXT,
duration INTEGER,
title TEXT,
mimeType TEXT,
sizeBytes INTEGER,
width INTEGER,
height INTEGER,
thumbnailPath TEXT,
-- 📖 23-Jul-2026: reading progress lives ON the media row, so a document reopens where it was left
--   (replaces the DataStore last-page tracking). totalPages = 0 until the doc has been opened once.
totalPages INTEGER NOT NULL DEFAULT 0,
progressPage INTEGER NOT NULL DEFAULT 0,
metaData TEXT AS RichTextMetadata,
-- 🖼️ 20-Aug-2026 sync: how a media file is named ON THE SERVER. localPath stays device-only.
assetId TEXT,
checksum TEXT
);

-- 🔧 15-Jul-2026 Phase 0.2: composite index — every content fetch filters by noteId and sorts by
--   position; without this the JOIN/WHERE scans the whole NoteContent table. Existing installs get
--   it via migration 1.sqm (v1 -> v2).
CREATE INDEX idx_notecontent_note_position ON NoteContent(noteId, position);

-- 🔧 15-Jul-2026 CRASH FIX ("no such module: fts5"): the FTS5 virtual table + triggers were
--   REMOVED from this schema. Some devices' framework SQLite is built WITHOUT the fts5 module
--   (crashed at Schema.create on a real device), so the managed schema must only contain SQL
--   every device supports. FTS5 is now created AT RUNTIME, only where supported and only when
--   search is first used — see NotesDao.ensureFtsIndex(); other devices use searchContentTextLike.

CREATE TABLE CanvasNodeEntity(
id TEXT NOT NULL PRIMARY KEY,
noteId TEXT NOT NULL REFERENCES Notes(id) ON DELETE CASCADE,
kind TEXT NOT NULL,
name TEXT NOT NULL DEFAULT '',
contentId TEXT REFERENCES NoteContent(id) ON DELETE CASCADE,
parentId TEXT REFERENCES CanvasNodeEntity(id) ON DELETE SET NULL,
x REAL NOT NULL DEFAULT 0.0,
y REAL NOT NULL DEFAULT 0.0,
width REAL NOT NULL DEFAULT 0.0,
height REAL NOT NULL DEFAULT 0.0,
z INTEGER NOT NULL DEFAULT 0,
locked INTEGER NOT NULL DEFAULT 0,
hidden INTEGER NOT NULL DEFAULT 0,
links TEXT NOT NULL DEFAULT '',
updatedAt TEXT
);

CREATE INDEX idx_canvasnode_note ON CanvasNodeEntity(noteId, z);

CREATE INDEX idx_canvasnode_viewport ON CanvasNodeEntity(noteId, x, y);

CREATE TABLE CanvasViewport(
noteId TEXT NOT NULL PRIMARY KEY REFERENCES Notes(id) ON DELETE CASCADE,
offsetX REAL NOT NULL DEFAULT 0.0,
offsetY REAL NOT NULL DEFAULT 0.0,
scale REAL NOT NULL DEFAULT 1.0,
updatedAt TEXT
);

CREATE TABLE Tags(
id TEXT NOT NULL PRIMARY KEY,
color TEXT,
label TEXT);

-- 🔄 20-Aug-2026 sync: the pull watermark, per user. It lives in SQLite and not DataStore so that
--   advancing it and committing the page it came from happen in ONE transaction.
CREATE TABLE SyncState(
userId TEXT NOT NULL PRIMARY KEY,
lastPulledAt INTEGER NOT NULL DEFAULT 0,
lastPulledId TEXT,
lastSyncedAt INTEGER NOT NULL DEFAULT 0
);

-- 🔄 every sync starts by asking "what is dirty?" — without this it is a full table scan
CREATE INDEX idx_notes_syncstatus ON Notes(syncStatus, deleted);
-- 🔧 21-Jul-2026 databasev2.md §2.4: now persists sync fields (ownerId/version/syncStatus/deleted)
insertOrUpdateNote:
INSERT OR REPLACE INTO Notes(id, categoryId, title, createdAt, updatedAt, ownerId, version, syncStatus, deleted, deletedAt, serverUpdatedAt)
VALUES(?,?,?,?,?,?,?,?,?,?,?);

-- 🔧 C1/S1: now persists title + media metadata
insertNoteContentById:
INSERT OR REPLACE INTO NoteContent ( id ,noteId, type, position, createdAt, updatedAt, localPath, url , text,  lat , long, address, duration, title, mimeType, sizeBytes, width, height, thumbnailPath, totalPages, progressPage, metaData, assetId, checksum )
VALUES (? , ?, ?, ?,  ?, ?, ?, ?, ?,? , ?, ?, ?, ?, ?, ?, ?, ?, ? ,?, ?, ?, ?, ?);

-- 📖 23-Jul-2026: reading progress is written on its own, not through a full row rewrite — the
--   reader saves on exit and must not clobber concurrent edits to the rest of the content row.
updateReadingProgress:
UPDATE NoteContent
SET progressPage = ?, totalPages = ?, updatedAt = ?
WHERE id = ?;

-- 🔧 21-Jul-2026 databasev2.md §2.4: an edit re-marks the row dirty (syncStatus) and stamps version
updateNotesById:
UPDATE Notes
SET title = ?, updatedAt = ?, version = ?, syncStatus = ?
WHERE id = ?;

updateNoteContentById:
UPDATE NoteContent
SET type = ?, position = ?, text = ?, url = ?, lat = ?, long = ?, metaData = ?
WHERE id = ?;

deleteNoteContentById:
DELETE FROM NoteContent
WHERE id = ?;

selectAllNotesContent:
SELECT * FROM NoteContent
WHERE noteId = ?
ORDER BY position ASC;

selectNoteContentById:
SELECT * FROM NoteContent
WHERE id = ?;

selectAll:
-- 🔄 20-Aug-2026 sync: deleted = 0 — a tombstone must never surface in a list, search or export
SELECT * FROM Notes WHERE deleted = 0;

selectById:
SELECT
    Notes.id AS noteId,
    Notes.categoryId,
    Notes.title,
    Notes.createdAt AS noteCreatedAt,
    Notes.updatedAt AS noteUpdatedAt,
    Notes.ownerId, -- 🔧 21-Jul-2026 databasev2.md §2.4: sync fields flow to the Note model
    Notes.version,
    Notes.syncStatus,
    Notes.deleted,
    Notes.deletedAt, -- 🔄 20-Aug-2026 sync
    Notes.serverUpdatedAt,
    NoteContent.id AS contentId,
    NoteContent.type,
    NoteContent.position,
    NoteContent.createdAt AS contentCreatedAt,
    NoteContent.updatedAt AS contentUpdatedAt,
    NoteContent.localPath,
    NoteContent.url,
    NoteContent.text,
    NoteContent.lat,
    NoteContent.long,
    NoteContent.address,
    NoteContent.duration,
    NoteContent.title AS contentTitle, -- 🔧 S1: media's OWN title (row.title was the note's title!)
    NoteContent.mimeType,
    NoteContent.sizeBytes,
    NoteContent.width,
    NoteContent.height,
    NoteContent.thumbnailPath,
    NoteContent.totalPages, -- 📖 23-Jul-2026: per-document reading progress
    NoteContent.progressPage,
    NoteContent.metaData,
    NoteContent.assetId, -- 🖼️ 20-Aug-2026 sync
    NoteContent.checksum
FROM Notes
LEFT JOIN NoteContent ON Notes.id = NoteContent.noteId
WHERE Notes.id = :id AND Notes.ownerId = :userId
ORDER BY NoteContent.position;

deleteNoteById :
DELETE FROM Notes WHERE  id = ? ;

-- 🔧 15-Jul-2026 Phase 0.1: one PAGE of note ids for the list screen. Paging happens on Notes ids
--   (LIMIT on the joined query would cut a note in the middle of its contents). The DAO then loads
--   each id with the existing selectById mapper. Ordered by id = creation order (ids are
--   timestamp-prefixed, see UniqueIdGenerator).
selectNoteIdsPage:
-- 🔄 20-Aug-2026 sync: deleted = 0 — a tombstone must never surface in a list, search or export
SELECT id FROM Notes
WHERE deleted = 0
ORDER BY id
LIMIT :limit OFFSET :offset;

-- 🔧 15-Jul-2026 Summary query: everything the LIST SCREEN needs, WITHOUT loading contents.
--   snippet: first non-empty TEXT block (may be NULL — media/doc-only notes are normal!);
--   per-type counts let the card describe textless notes ("3 photos · 1 audio");
--   thumbnail: first visual media's thumbnailPath (falls back to the file itself).
--   Every subquery hits idx_notecontent_note_position.
selectNoteSummariesPage:
SELECT
    n.id,
    n.categoryId,
    n.title,
    n.createdAt,
    n.updatedAt,
    (SELECT SUBSTR(c.text, 1, 200) FROM NoteContent c
        WHERE c.noteId = n.id AND c.type = 'TEXT' AND c.text IS NOT NULL AND c.text != ''
        ORDER BY c.position LIMIT 1) AS snippet,
    (SELECT COUNT(*) FROM NoteContent c WHERE c.noteId = n.id) AS contentCount,
    (SELECT COUNT(*) FROM NoteContent c WHERE c.noteId = n.id AND c.type IN ('IMAGE','GIF')) AS imageCount,
    (SELECT COUNT(*) FROM NoteContent c WHERE c.noteId = n.id AND c.type = 'VIDEO') AS videoCount,
    (SELECT COUNT(*) FROM NoteContent c WHERE c.noteId = n.id AND c.type = 'AUDIO') AS audioCount,
    (SELECT COUNT(*) FROM NoteContent c WHERE c.noteId = n.id AND c.type IN ('PDF','DOCX')) AS docCount,
    (SELECT COALESCE(c.thumbnailPath, c.localPath, c.url) FROM NoteContent c
        WHERE c.noteId = n.id AND c.type IN ('IMAGE','VIDEO','GIF')
        ORDER BY c.position LIMIT 1) AS thumbnailPath
-- 🔄 20-Aug-2026 sync: deleted = 0 — a tombstone must never surface in a list, search or export
FROM Notes n
WHERE n.deleted = 0 AND n.ownerId = :userId
ORDER BY n.id
LIMIT :limit OFFSET :offset;

selectWithAllContent:
SELECT
    Notes.id AS noteId,
    Notes.categoryId,
    Notes.title,
    Notes.createdAt AS noteCreatedAt,
    Notes.updatedAt AS noteUpdatedAt,
    Notes.ownerId, -- 🔧 21-Jul-2026 databasev2.md §2.4: sync fields flow to the Note model
    Notes.version,
    Notes.syncStatus,
    Notes.deleted,
    Notes.deletedAt, -- 🔄 20-Aug-2026 sync
    Notes.serverUpdatedAt,
    NoteContent.id AS contentId,
    NoteContent.type,
    NoteContent.position,
    NoteContent.createdAt AS contentCreatedAt,
    NoteContent.updatedAt AS contentUpdatedAt,
    NoteContent.localPath,
    NoteContent.url,
    NoteContent.text,
    NoteContent.lat,
    NoteContent.long,
    NoteContent.address,
    NoteContent.duration,
    NoteContent.title AS contentTitle, -- 🔧 S1: media's OWN title
    NoteContent.mimeType,
    NoteContent.sizeBytes,
    NoteContent.width,
    NoteContent.height,
    NoteContent.thumbnailPath,
    NoteContent.totalPages, -- 📖 23-Jul-2026: per-document reading progress
    NoteContent.progressPage,
    NoteContent.metaData,
    NoteContent.assetId, -- 🖼️ 20-Aug-2026 sync
    NoteContent.checksum
FROM Notes
LEFT JOIN NoteContent ON Notes.id = NoteContent.noteId
-- 🔄 20-Aug-2026 sync: deleted = 0 — a tombstone must never surface in a list, search or export
WHERE Notes.deleted = 0 AND Notes.ownerId = :userId
ORDER BY Notes.id, NoteContent.position;
-- LIMIT ? OFFSET ?;

-- 🔧 15-Jul-2026 CRASH FIX: content search that works on EVERY SQLite build (no fts5 module
--   required). Used as the fallback when the device lacks FTS5; capable devices get the faster
--   MATCH variant at runtime (NotesDao.searchContentViaFts). Same result shape.
searchContentTextLike:
SELECT
    n.id, n.categoryId, n.title, n.createdAt, n.updatedAt,
    SUBSTR(c.text, 1, 200) AS snippet
FROM NoteContent c
JOIN Notes n ON n.id = c.noteId
WHERE c.type = 'TEXT' AND c.text LIKE '%' || :query || '%' AND n.deleted = 0 AND n.ownerId = :userId
GROUP BY n.id
ORDER BY n.updatedAt DESC
LIMIT 50;

-- 🔧 15-Jul-2026 Phase 2.2: title search (titles are not in the FTS index) — merged with the
--   content matches in the DAO.
searchTitles:
SELECT id, categoryId, title, createdAt, updatedAt
FROM Notes
WHERE title LIKE '%' || :query || '%' AND deleted = 0 AND ownerId = :userId
ORDER BY updatedAt DESC
LIMIT 50;

createTag:
INSERT OR REPLACE INTO Tags(id, label, color)
VALUES(?,?,?);

updateTag:
UPDATE Tags
SET color = ?, label = ?
WHERE id = ?;

deleteTag :
DELETE FROM Tags WHERE id = ?;

getTags:
SELECT id, label, color FROM Tags;

getTag:
SELECT id, label, color FROM Tags WHERE id = ?;


upsertCanvasNode:
INSERT OR REPLACE INTO CanvasNodeEntity(id, noteId, kind, name, contentId, parentId, x, y, width, height, z, locked, hidden, links, updatedAt)
VALUES(?,?,?,?,?,?,?,?,?,?,?,?,?,?,?);

deleteCanvasNode:
DELETE FROM CanvasNodeEntity WHERE id = ?;

deleteCanvasNodesForNote:
DELETE FROM CanvasNodeEntity WHERE noteId = ?;

selectCanvasNodes:
SELECT * FROM CanvasNodeEntity WHERE noteId = ? ORDER BY z ASC;

selectCanvasNodesInRect:
SELECT * FROM CanvasNodeEntity
WHERE noteId = :noteId
AND hidden = 0
AND x < :right AND (x + width) > :left
AND y < :bottom AND (y + height) > :top
ORDER BY z ASC;

countCanvasNodes:
SELECT count(*) FROM CanvasNodeEntity WHERE noteId = ?;

selectCanvasNodeForContent:
SELECT * FROM CanvasNodeEntity WHERE contentId = ?;

deleteOrphanCanvasNodes:
DELETE FROM CanvasNodeEntity
WHERE contentId IS NOT NULL
AND contentId NOT IN (SELECT id FROM NoteContent);

moveCanvasNode:
UPDATE CanvasNodeEntity SET x = ?, y = ?, updatedAt = ? WHERE id = ?;

resizeCanvasNode:
UPDATE CanvasNodeEntity SET width = ?, height = ?, updatedAt = ? WHERE id = ?;

raiseCanvasNode:
UPDATE CanvasNodeEntity SET z = ?, updatedAt = ? WHERE id = ?;

renameCanvasNode:
UPDATE CanvasNodeEntity SET name = ?, updatedAt = ? WHERE id = ?;

upsertCanvasViewport:
INSERT OR REPLACE INTO CanvasViewport(noteId, offsetX, offsetY, scale, updatedAt)
VALUES(?,?,?,?,?);

selectCanvasViewport:
SELECT * FROM CanvasViewport WHERE noteId = ?;

-- 🔄 20-Aug-2026 sync: the push queue. Tombstones are IN it on purpose — a delete has to travel too.
--   'PENDING' is the schema default, so "not SYNCED" is the dirty predicate, not "== PENDING".
selectDirtyNoteIds:
SELECT id FROM Notes
WHERE syncStatus != 'SYNCED' AND ownerId = :userId
ORDER BY updatedAt
LIMIT :limit;

countDirtyNotes:
SELECT count(*) FROM Notes WHERE syncStatus != 'SYNCED' AND ownerId = :userId;

-- 🔄 the note row survives as a tombstone; its contents do not, mirroring the server's soft delete
softDeleteNoteById:
UPDATE Notes
SET deleted = 1, syncStatus = 'PENDING_DELETE', deletedAt = ?, updatedAt = ?
WHERE id = ?;

deleteNoteContentsForNote:
DELETE FROM NoteContent WHERE noteId = ?;

-- 🔄 only the server may mark a note clean, and only with the version IT accepted
-- 🔄 28-Aug-2026 — guarded on the version that actually went up: a save made while the push was in
--   flight has already moved the version on, and cleaning THAT row loses the edit with no trace.
markNoteSynced:
UPDATE Notes
SET syncStatus = CASE WHEN version = :pushedVersion THEN 'SYNCED' ELSE syncStatus END,
    version = CASE WHEN version = :pushedVersion THEN :acceptedVersion ELSE version END,
    serverUpdatedAt = :serverUpdatedAt
WHERE id = :id;

-- 🔄 a tombstone is only droppable once we have pulled PAST it, so no pull can resurrect it
purgeAckedTombstones:
DELETE FROM Notes
WHERE deleted = 1 AND syncStatus = 'SYNCED'
AND serverUpdatedAt IS NOT NULL AND serverUpdatedAt < :before;

selectSyncState:
SELECT * FROM SyncState WHERE userId = ?;

upsertSyncState:
INSERT OR REPLACE INTO SyncState(userId, lastPulledAt, lastPulledId, lastSyncedAt)
VALUES(?,?,?,?);

-- 🖼️ 20-Sep-2026 sync: notes holding a file THIS device has and the server does not. The mirror
--   image of selectNoteIdsNeedingMedia, and the thing that was missing: uploads only ever ran for
--   notes sitting in the dirty queue, so a file attached to an already-synced note, or one whose
--   first upload failed, was never looked at again. A file is pending until it HAS an assetId.
selectNoteIdsNeedingUpload:
SELECT DISTINCT c.noteId FROM NoteContent c
JOIN Notes n ON n.id = c.noteId
WHERE n.deleted = 0
AND (c.assetId IS NULL OR c.assetId = '')
AND c.localPath IS NOT NULL AND c.localPath != ''
LIMIT :limit;

-- 🖼️ 20-Sep-2026 sync: a note whose file just gained an assetId has to go BACK on the push queue,
--   or the id never reaches the server and the other device has nothing to download. Only a clean
--   note is touched: PENDING and PENDING_DELETE already describe something stronger.
markNoteDirtyForMedia:
UPDATE Notes
SET syncStatus = 'PENDING_UPDATE'
WHERE id = ? AND syncStatus = 'SYNCED';

-- 🖼️ 20-Aug-2026 sync: notes holding media the server has but this device does not. Drives the
--   eager backfill, and covers leftovers from a cycle that ran out of its download budget.
selectNoteIdsNeedingMedia:
SELECT DISTINCT c.noteId FROM NoteContent c
JOIN Notes n ON n.id = c.noteId
WHERE n.deleted = 0
AND c.assetId IS NOT NULL AND c.assetId != ''
AND (c.localPath IS NULL OR c.localPath = '')
LIMIT :limit;

-- 💬 31-Aug-2026 chat: conversations and messages. Existing installs get these via 8.sqm.
--   attachments is a JSON string rather than a typed column on purpose: it keeps :core:database
--   free of chat-specific ColumnAdapters, and ChatDao is the only code that reads or writes it.
CREATE TABLE ChatConversationEntity(
id TEXT NOT NULL PRIMARY KEY,
kind TEXT NOT NULL DEFAULT 'DIRECT',
participantIds TEXT NOT NULL DEFAULT '',
peerId TEXT,
peerName TEXT,
peerAvatarUrl TEXT,
title TEXT,
createdBy TEXT,
createdAt INTEGER NOT NULL DEFAULT 0,
updatedAt INTEGER NOT NULL DEFAULT 0,
serverUpdatedAt INTEGER,
lastMessageAt INTEGER NOT NULL DEFAULT 0,
lastMessagePreview TEXT NOT NULL DEFAULT '',
lastMessageSenderId TEXT,
unreadCount INTEGER NOT NULL DEFAULT 0,
deleted INTEGER NOT NULL DEFAULT 0
);

CREATE TABLE ChatMessageEntity(
id TEXT NOT NULL PRIMARY KEY,
-- 🔗 deliberately NOT a foreign key. A message routinely arrives BEFORE its conversation
-- row does (someone starts a chat with you), and an FK would reject that insert outright —
-- losing the message. ChatRepository fetches the missing conversation instead, and
-- deleteMessagesForConversation is the cleanup path.
conversationId TEXT NOT NULL,
senderId TEXT,
kind TEXT NOT NULL DEFAULT 'USER',
text TEXT NOT NULL DEFAULT '',
attachments TEXT NOT NULL DEFAULT '',
clientId TEXT,
replyToId TEXT,
status TEXT NOT NULL DEFAULT 'SENDING',
aiState TEXT,
aiError TEXT,
createdAt INTEGER NOT NULL DEFAULT 0,
updatedAt INTEGER NOT NULL DEFAULT 0,
serverUpdatedAt INTEGER,
deleted INTEGER NOT NULL DEFAULT 0
);

-- Paging a thread is (conversationId, createdAt); without this every scroll scans the table
CREATE INDEX idx_chatmessage_thread ON ChatMessageEntity(conversationId, createdAt);

-- A resend repeats clientId, and this is what makes the "have I already stored this?" lookup cheap
CREATE INDEX idx_chatmessage_client ON ChatMessageEntity(conversationId, clientId);

-- The outbox: everything typed while offline, oldest first
CREATE INDEX idx_chatmessage_pending ON ChatMessageEntity(status, createdAt);

-- The inbox list: live conversations, most recent activity first
CREATE INDEX idx_chatconversation_recent ON ChatConversationEntity(deleted, lastMessageAt);


-- ── chat ──────────────────────────────────────────────────────────────────────
-- 💬 31-Aug-2026: the local thread is the source of truth on screen. A message is written here
--   FIRST and only then sent, so a bubble appears instantly and survives losing the network.

upsertConversation:
INSERT OR REPLACE INTO ChatConversationEntity(
id, kind, participantIds, peerId, peerName, peerAvatarUrl, title, createdBy,
createdAt, updatedAt, serverUpdatedAt, lastMessageAt, lastMessagePreview,
lastMessageSenderId, unreadCount, deleted)
VALUES(?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?);

selectConversations:
SELECT * FROM ChatConversationEntity
-- 🔒 separators both sides so ',a,b,' LIKE '%,a,%' is exact, not a substring hit
WHERE deleted = 0 AND (',' || participantIds || ',') LIKE ('%,' || :userId || ',%')
ORDER BY lastMessageAt DESC, id DESC;

selectConversationById:
SELECT * FROM ChatConversationEntity WHERE id = ?;

-- 🔢 the badge on the bottom bar: every unread message across every live thread
selectTotalUnread:
SELECT COALESCE(SUM(unreadCount), 0) FROM ChatConversationEntity
WHERE deleted = 0 AND (',' || participantIds || ',') LIKE ('%,' || :userId || ',%');

updateConversationUnread:
UPDATE ChatConversationEntity SET unreadCount = :unreadCount WHERE id = :id;

-- 📌 the list row follows the newest message without rewriting the whole conversation row
touchConversation:
UPDATE ChatConversationEntity
SET lastMessageAt = :lastMessageAt,
    lastMessagePreview = :lastMessagePreview,
    lastMessageSenderId = :lastMessageSenderId,
    updatedAt = :updatedAt
WHERE id = :id;

softDeleteConversation:
UPDATE ChatConversationEntity SET deleted = 1, updatedAt = :updatedAt WHERE id = :id;

upsertMessage:
INSERT OR REPLACE INTO ChatMessageEntity(
id, conversationId, senderId, kind, text, attachments, clientId, replyToId,
status, aiState, aiError, createdAt, updatedAt, serverUpdatedAt, deleted)
VALUES(?,?,?,?,?,?,?,?,?,?,?,?,?,?,?);

selectMessagesPage:
SELECT * FROM ChatMessageEntity
WHERE conversationId = :conversationId AND deleted = 0
ORDER BY createdAt DESC, id DESC
LIMIT :limit OFFSET :offset;

selectMessagesBefore:
SELECT * FROM ChatMessageEntity
WHERE conversationId = :conversationId AND deleted = 0 AND createdAt < :before
ORDER BY createdAt DESC, id DESC
LIMIT :limit;

selectMessageById:
SELECT * FROM ChatMessageEntity WHERE id = ?;

-- 🔁 the local half of send idempotency: has this device already stored this clientId?
selectMessageByClientId:
SELECT * FROM ChatMessageEntity WHERE conversationId = :conversationId AND clientId = :clientId;

-- ✍️ an AI reply grows token by token, so only the text and the state move
updateMessageText:
UPDATE ChatMessageEntity
SET text = :text, aiState = :aiState, aiError = :aiError, updatedAt = :updatedAt
WHERE id = :id;

updateMessageStatus:
UPDATE ChatMessageEntity SET status = :status, updatedAt = :updatedAt WHERE id = :id;

-- 🆔 the server's id replaces the optimistic one; INSERT OR REPLACE cannot change a primary key
replaceMessageId:
UPDATE ChatMessageEntity
SET id = :serverId, status = :status, serverUpdatedAt = :serverUpdatedAt, updatedAt = :updatedAt
WHERE id = :localId;

-- 👀 my own messages the other side has now read
markOutgoingRead:
UPDATE ChatMessageEntity
SET status = 'READ', updatedAt = :updatedAt
WHERE conversationId = :conversationId AND senderId = :senderId
AND createdAt <= :upTo AND status != 'READ';

-- 📤 the outbox: what was typed while offline, oldest first so order is preserved
selectPendingMessages:
SELECT * FROM ChatMessageEntity
WHERE status IN ('SENDING', 'FAILED') AND deleted = 0
ORDER BY createdAt ASC
LIMIT :limit;

softDeleteMessage:
UPDATE ChatMessageEntity
SET deleted = 1, text = '', attachments = '', updatedAt = :updatedAt
WHERE id = :id;

deleteMessagesForConversation:
DELETE FROM ChatMessageEntity WHERE conversationId = ?;

deleteMessageById:
DELETE FROM ChatMessageEntity WHERE id = :id;
