-- 💬 31-Aug-2026 chat: two new tables, nothing existing touched. An install that already has notes
--   keeps every one of them — no column is dropped, retyped or renamed.
--
-- 🔧 31-Aug-2026 — the tables were originally ChatConversation/ChatMessage, whose GENERATED
--   classes collided by simple name with the domain models in :core:model that are exported
--   into the same shared.framework. Same defect as CanvasNode in 5.sqm/6.sqm, same fix:
--   they are *Entity now. Every statement below is idempotent, so a dev install that already
--   ran the ORIGINAL 8.sqm passes straight through. Chat rows are re-fetched from the server,
--   so dropping the old tables loses nothing. Notes are never touched.
--   attachments is a JSON string rather than a typed column on purpose: it keeps :core:database
--   free of chat-specific ColumnAdapters, and ChatDao is the only code that reads or writes it.
DROP TABLE IF EXISTS ChatConversation;

DROP TABLE IF EXISTS ChatMessage;

CREATE TABLE IF NOT EXISTS ChatConversationEntity(
id TEXT NOT NULL PRIMARY KEY,
kind TEXT NOT NULL DEFAULT 'DIRECT',
participantIds TEXT NOT NULL DEFAULT '',
peerId TEXT,
peerName TEXT,
peerAvatarUrl TEXT,
title TEXT,
createdBy TEXT,
createdAt INTEGER NOT NULL DEFAULT 0,
updatedAt INTEGER NOT NULL DEFAULT 0,
serverUpdatedAt INTEGER,
lastMessageAt INTEGER NOT NULL DEFAULT 0,
lastMessagePreview TEXT NOT NULL DEFAULT '',
lastMessageSenderId TEXT,
unreadCount INTEGER NOT NULL DEFAULT 0,
deleted INTEGER NOT NULL DEFAULT 0
);

CREATE TABLE IF NOT EXISTS ChatMessageEntity(
id TEXT NOT NULL PRIMARY KEY,
-- 🔗 deliberately NOT a foreign key. A message routinely arrives BEFORE its conversation
-- row does (someone starts a chat with you), and an FK would reject that insert outright —
-- losing the message. ChatRepository fetches the missing conversation instead, and
-- deleteMessagesForConversation is the cleanup path.
conversationId TEXT NOT NULL,
senderId TEXT,
kind TEXT NOT NULL DEFAULT 'USER',
text TEXT NOT NULL DEFAULT '',
attachments TEXT NOT NULL DEFAULT '',
clientId TEXT,
replyToId TEXT,
status TEXT NOT NULL DEFAULT 'SENDING',
aiState TEXT,
aiError TEXT,
createdAt INTEGER NOT NULL DEFAULT 0,
updatedAt INTEGER NOT NULL DEFAULT 0,
serverUpdatedAt INTEGER,
deleted INTEGER NOT NULL DEFAULT 0
);

-- Paging a thread is (conversationId, createdAt); without this every scroll scans the table
CREATE INDEX IF NOT EXISTS idx_chatmessage_thread ON ChatMessageEntity(conversationId, createdAt);

-- A resend repeats clientId, and this is what makes the "have I already stored this?" lookup cheap
CREATE INDEX IF NOT EXISTS idx_chatmessage_client ON ChatMessageEntity(conversationId, clientId);

-- The outbox: everything typed while offline, oldest first
CREATE INDEX IF NOT EXISTS idx_chatmessage_pending ON ChatMessageEntity(status, createdAt);

-- The inbox list: live conversations, most recent activity first
CREATE INDEX IF NOT EXISTS idx_chatconversation_recent ON ChatConversationEntity(deleted, lastMessageAt);
